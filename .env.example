# BookLoop AI Environment Variables Template
# Copy this file to .env and configure your values

# Google Gemini API (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# JWT Security
JWT_SECRET_KEY=your_random_secret_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./bookloop.db

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001

# Delivery Courier Tariff Configuration
DEFAULT_BASE_DELIVERY_FEE=35.0
DEFAULT_PER_KM_RATE=1.8
DEFAULT_PER_250G_RATE=5.0
DEFAULT_FREE_DELIVERY_THRESHOLD=800.0
